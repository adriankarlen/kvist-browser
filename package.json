{
  "name": "kvist",
  "version": "0.0.0",
  "description": "A highly configurable TUI-styled browser built upon Chromium",
  "license": "MIT",
  "author": {
    "name": "Adrian Malmodin",
    "email": "113891532+adriankarlen@users.noreply.github.com"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp check",
    "test": "vp test",
    "package": "vp build && electron-builder --publish never",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "arktype": "^2.2.3",
    "drizzle-arktype": "^0.1.3",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "smol-toml": "^1.7.1",
    "tldts-experimental": "^7.4.10"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24.13.3",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "svelte": "^5.56.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plus": "^0.2.7"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "build": {
    "appId": "dev.kvist.browser",
    "productName": "Kvist",
    "icon": "images/kvist-logo.png",
    "files": [
      "dist/**/*",
      "images/kvist-logo.png"
    ],
    "asarUnpack": [
      "dist/main/migrations/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "desktopName": "kvist"
}
