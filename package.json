{
  "name": "kvist",
  "version": "0.0.0",
  "description": "A highly configurable TUI-styled browser built upon Chromium",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp check",
    "test": "vp test",
    "package": "vp build && electron-builder --dir",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "smol-toml": "^1.7.1",
    "tldts-experimental": "^7.4.10"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24.13.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "svelte": "^5.56.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plus": "^0.2.7"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.20.0",
  "build": {
    "appId": "dev.kvist.browser",
    "productName": "Kvist",
    "icon": "images/kvist-logo.png",
    "files": [
      "dist/**/*",
      "images/kvist-logo.png"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir"
    },
    "linux": {
      "target": "dir",
      "category": "Network"
    },
    "win": {
      "target": "dir"
    }
  }
}
